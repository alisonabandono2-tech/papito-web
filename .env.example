# Papito — exemplo de variáveis de ambiente (SEM segredos).
# Copie para ".env" e preencha quando o backend (repo `api`) estiver no ar.

# Base URL da API que faz a ponte com a casa: catálogo de jogos, login vinculado (SSO),
# saldo / depósito / saque e abertura do jogo. Nenhuma senha do jogador passa pelo frontend.
VITE_API_BASE_URL=https://api.seu-dominio.com
